# Optional. Without this set, llm_triage.py falls back to a deterministic
# offline template -- the pipeline runs fully without an API key.
ANTHROPIC_API_KEY=

# Optional, defaults to claude-haiku-4-5-20251001 (fast/cheap, well-suited
# to this structured triage-summary task).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
